{
    "name": "electron-main",
    "version": "1.0.0",
    "main": "dist/main.js",
    "scripts": {
        "dev": "tsc && electron .",
        "build": "tsc",
        "dist": "electron-builder"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.0",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.0",
        "typescript": "^5.3.0"
    },
    "build": {
        "buildDependenciesFromSource": true,
        "npmRebuild": false,
        "appId": "com.tallycat.app",
        "productName": "TallyCat",
        "directories": {
            "output": "../../dist/installers"
        },
        "files": [
            "package.json",
            {
                "from": "../../dist/electron",
                "to": "dist"
            },
            {
                "from": "../../dist/web",
                "to": "web"
            }
        ],
        "extraMetadata": {
            "main": "dist/main.js"
        },
        "mac": {
            "target": "dmg",
            "category": "public.app-category.productivity"
        },
        "win": {
            "target": "nsis"
        },
        "linux": {
            "target": "AppImage"
        }
    },
    "dependencies": {
        "sqlite3": "^5.1.7"
    }
}